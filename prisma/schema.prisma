generator client {
  provider     = "prisma-client-js"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model post_tags {
  postId    String   @db.Uuid                                            @map("post_id")
  tagId     String   @db.Uuid                                            @map("tag_id")
  createdAt DateTime @db.Timestamptz() @default(now())                   @map("created_at")
  updatedAt DateTime @db.Timestamptz() @updatedAt                        @map("updated_at")

  @@id([postId, tagId])
}

model posts {
  id        String   @db.Uuid          @default(dbgenerated("uuidv7()")) @id
  createdAt DateTime @db.Timestamptz() @default(now())                   @map("created_at")
  updatedAt DateTime @db.Timestamptz() @updatedAt                        @map("updated_at")
  userId    String   @db.Uuid                                            @map("user_id")
  title     String
  content   String
}

model tags {
  id        String   @db.Uuid          @default(dbgenerated("uuidv7()")) @id
  createdAt DateTime @db.Timestamptz() @default(now())                   @map("created_at")
  updatedAt DateTime @db.Timestamptz() @updatedAt                        @map("updated_at")
  name      String
}

model users {
  id        String   @db.Uuid          @default(dbgenerated("uuidv7()")) @id
  createdAt DateTime @db.Timestamptz() @default(now())                   @map("created_at")
  updatedAt DateTime @db.Timestamptz() @updatedAt                        @map("updated_at")
  nickname  String   @unique
}
